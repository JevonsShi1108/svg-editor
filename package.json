{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precli": "npm run build",
    "cli": "node dist/main.js",
    "test:e2e": "npm run build && vitest run test/e2e --reporter=default --reporter=json --outputFile=artifacts/test-results/e2e.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format:check": "prettier --check src test scripts *.json *.mjs vitest*.config.ts AGENTS.md doc/PROGRESS.md doc/INPUT_PROFILE.md doc/TEST_TRACEABILITY.md doc/TEST_REPORT.md doc/README.md doc/ARCHITECTURE_REVIEW.md",
    "check:deps": "node scripts/check-deps.mjs",
    "test:unit": "vitest run test/unit test/regressions --reporter=default --reporter=json --outputFile=artifacts/test-results/unit.json",
    "test:property": "vitest run test/property --reporter=default --reporter=json --outputFile=artifacts/test-results/property.json",
    "test:integration": "vitest run test/integration --reporter=default --reporter=json --outputFile=artifacts/test-results/integration.json",
    "test:model": "vitest run test/model-run --reporter=default --reporter=json --outputFile=artifacts/test-results/model.json",
    "test:coverage": "npm run build && vitest run --coverage --reporter=default --reporter=json --outputFile=artifacts/test-results/coverage.json",
    "test:performance": "node --expose-gc node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts --reporter=default --reporter=json --outputFile=artifacts/test-results/performance.json",
    "verify:stage": "node scripts/verify-stage.mjs",
    "verify": "node scripts/verify.mjs",
    "random:local": "node scripts/random-profile.mjs local",
    "random:ci": "node scripts/random-profile.mjs ci",
    "random:release": "node scripts/random-profile.mjs release",
    "check:traceability": "node scripts/check-traceability.mjs",
    "doc:diagram": "node scripts/render-architecture.mjs",
    "doc:examples": "npm run build && node scripts/generate-examples.mjs",
    "candidate:verify": "node scripts/verify-candidate.mjs"
  },
  "dependencies": {
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "5.0.5",
    "@xmldom/xmldom": "0.9.12",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.13.0",
    "fast-check": "4.5.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
