{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precli": "npm run build",
    "cli": "node dist/main.js",
    "test:e2e": "npm run build && vitest run test/e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format:check": "prettier --check src test scripts *.json *.mjs AGENTS.md doc/PROGRESS.md doc/INPUT_PROFILE.md doc/TEST_TRACEABILITY.md doc/TEST_REPORT.md",
    "check:deps": "node scripts/check-deps.mjs",
    "test:unit": "vitest run test/unit test/regressions",
    "test:property": "vitest run test/property",
    "test:integration": "vitest run test/integration",
    "test:model": "vitest run test/model-run",
    "verify:stage": "node scripts/verify-stage.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "5.0.5",
    "@xmldom/xmldom": "0.9.12",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.13.0",
    "fast-check": "4.5.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
